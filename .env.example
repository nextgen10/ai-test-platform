# Copy to .env and adjust. Never commit real tokens.

# --- execution backend: local | docker | kubernetes
EXECUTOR=local

# --- generation engine: copilot | mock
#   copilot  real GitHub Copilot CLI (needs a Copilot-enabled token)
#   mock     deterministic stand-in so the platform runs without Copilot access
ENGINE=mock

# --- Copilot auth. Required only when ENGINE=copilot.
#
# The CLI reads COPILOT_GITHUB_TOKEN, then GH_TOKEN, then GITHUB_TOKEN, in that
# order of precedence. COPILOT_GITHUB_TOKEN is the most specific and is what this
# platform forwards to the runner. Env vars override any stored OAuth login.
#
# Create the token at https://github.com/settings/personal-access-tokens/new
#   - Resource owner: your PERSONAL account (not an organization — the required
#     permission only exists on user-owned tokens)
#   - Account permissions -> add "Copilot Requests"
#
# Supported token types:
#   github_pat_  fine-grained PAT       <- use this
#   gho_         OAuth (gh auth login / copilot /login)
#   ghu_         GitHub App user-to-server
#   ghp_         classic PAT            <- NOT supported
#
# A container has no stored interactive login, so this must be set for anything
# beyond EXECUTOR=local.
# COPILOT_GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# Optional: pin the model the agents use.
# Choices (CLI 0.0.365): claude-sonnet-4.5, claude-haiku-4.5, claude-opus-4.5,
# claude-sonnet-4, gpt-5, gpt-5.1, gpt-5.1-codex, gpt-5-mini, gpt-4.1,
# gemini-3-pro-preview
# COPILOT_MODEL=claude-sonnet-4.5

# --- persistence. SQLite by default; point at PostgreSQL for anything shared.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/aitest

# --- artifacts
# ARTIFACT_ROOT=./artifacts

# --- runner
RUNNER_IMAGE=ai-test-runner:dev
JOB_TIMEOUT_SECONDS=600
MAX_REVIEW_ATTEMPTS=2

# --- quality gate thresholds (read by the runner's validator)
GATE_MIN_TEST_CASES=5
GATE_MAX_DUPLICATE_RATE=0.10
GATE_MIN_STEPS=2
GATE_REQUIRED_CATEGORIES=3

# --- limits
MAX_CONCURRENT_JOBS_PER_USER=5
MAX_CONCURRENT_JOBS_TOTAL=20

# --- auth (required)
#
# AUTH_MODE=token is the default and needs API_TOKENS. The orchestrator refuses
# to start without it, so an unconfigured deployment can never serve an open API
# — registry writes become agent system prompts, which the CLI then executes.
#
# Format: "<token>:<name>:<role>" entries, comma separated.
# Roles, in increasing order of privilege:
#   reader    read the catalog, jobs, artifacts and logs
#   operator  + submit, approve, reject, cancel and reprocess jobs; use chat
#   author    + create, update and delete hub entities
#   admin     + everything
#
# Generate a token with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
AUTH_MODE=token
# API_TOKENS=tok_aaa...:ci-pipeline:operator,tok_bbb...:qa-lead:author
#
# The UI proxy attaches this token server-side, so the browser never holds a
# credential. It must be one of the values listed in API_TOKENS above.
# API_TOKEN=tok_aaa...
#
# ./start.sh generates both for you when neither is set.
#
# The UI login page accepts one of these tokens and stores it in an httpOnly
# cookie. Locally, start.sh also sets API_TOKEN so the proxy can attach a
# shared credential (UI_AUTH_MODE=shared). Kubernetes sets UI_AUTH_MODE=session
# so every browser visitor must log in.
# UI_AUTH_MODE=shared
#
# Serve /docs and /openapi.json. Off in Kubernetes unless you set this.
# ENABLE_DOCS=1
#
# Set AUTH_MODE=disabled only for a loopback development run, and only with
# ALLOW_INSECURE_AUTH=1 — the process otherwise refuses to start.
# AUTH_MODE=disabled
# ALLOW_INSECURE_AUTH=1

# --- per-job control files and credentials
# Deliberately NOT under ARTIFACT_ROOT: everything in a job workspace is
# downloadable through the artifacts API, and this holds GitHub tokens.
# JOB_RUNTIME_ROOT=./.job-runtime

# --- logging
# text (human-readable) or json (one object per line, for a log pipeline)
LOG_FORMAT=text
LOG_LEVEL=INFO

# --- chat
# CHAT_STREAM_TIMEOUT=300      seconds before a wedged agent is killed
# CHAT_MAX_HISTORY_CHARS=24000 how much prior conversation is replayed
# CHAT_MAX_CONCURRENT_PER_USER=2
# CHAT_MAX_CONCURRENT_TOTAL=8

# --- webhooks
# Callback URLs must be https to a public host. Private, loopback, link-local
# and metadata addresses are rejected at create time and again at send time.

# --- work queue
#
# Jobs are rows that any worker claims with a conditional UPDATE, so more than
# one replica is safe. A worker renews its lease while it works; one that dies
# stops renewing and its job returns to the queue.
# RUN_WORKER=true              set false for an API-only replica
# WORKER_CONCURRENCY=2         jobs one worker runs at once
# JOB_LEASE_SECONDS=120        how long a claim is good for
# JOB_LEASE_RENEW_SECONDS=30   how often a working worker extends it
# JOB_POLL_SECONDS=2           how often an idle worker looks for work
# JOB_MAX_ATTEMPTS=2           retries before a job whose worker keeps dying is failed

# --- scheduling and webhooks
# RUN_SCHEDULER=true           set false to stop this replica firing schedules
# SCHEDULER_TICK_SECONDS=20    how often due schedules and webhooks are checked
# WEBHOOK_MAX_ATTEMPTS=5       delivery attempts before giving up
# WEBHOOK_TIMEOUT_SECONDS=10

# --- agents
# MAX_PARALLEL_AGENTS=4        agents run at once within one dependency wave
# AGENT_TIMEOUT_SECONDS=300    per-agent ceiling inside a workflow
# AGENT_TEST_TIMEOUT_SECONDS=180  tighter budget for the interactive test harness

# --- cost reporting
# Costs are estimated from a list-price table. Override it rather than editing
# code when prices move; a model absent from the table reports no cost at all
# rather than zero.
# COST_TABLE_JSON={"my-model":{"input":1.0,"output":5.0}}

# --- kubernetes (EXECUTOR=kubernetes)
K8S_NAMESPACE=ai-testing
K8S_SERVICE_ACCOUNT=ai-test-runner
K8S_SECRET_NAME=copilot-auth
K8S_ARTIFACT_PVC=ai-test-artifacts
K8S_HUB_PVC=ai-test-hub
K8S_TTL_SECONDS=3600
