# Orchestrator address. Used by the Vite dev-server proxy only — the browser
# always talks to this origin at /api/v1.
API_TARGET=http://127.0.0.1:8100

# Dev/preview port (Vite UI). Backend stays on 8100 via start.sh / BACKEND_PORT.
PORT=3300

# Sub-path mount (Domino notebook sessions). Leave unset locally.
# VITE_BASE_PATH=/

# Backend (used by ./start.sh)
# EXECUTOR=local
# ENGINE=mock
# BACKEND_PORT=8100
# FRONTEND_PORT=3300

# ---------------------------------------------------------------------------
# Microsoft Entra ID (Azure AD) sign-in.
#
# Leave VITE_AUTH_ENABLED=false to run the app without an Azure tenant; every
# route stays open and the nav shows a local identity. Set it to true and fill
# in the two ids below to put MSAL in front of the app.
# ---------------------------------------------------------------------------
VITE_AUTH_ENABLED=false
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
# Space-separated scopes requested for the orchestrator API, e.g.
# VITE_AZURE_API_SCOPES=api://<app-id>/access_as_user
VITE_AZURE_API_SCOPES=
