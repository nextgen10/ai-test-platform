# Copy to .env and adjust. Never commit real tokens.

# --- execution backend: local | docker | kubernetes
EXECUTOR=local

# --- generation engine: copilot | mock
#   copilot  real GitHub Copilot CLI (needs a Copilot-enabled token)
#   mock     deterministic stand-in so the platform runs without Copilot access
ENGINE=mock

# --- Copilot auth. Required only when ENGINE=copilot.
#
# The CLI reads COPILOT_GITHUB_TOKEN, then GH_TOKEN, then GITHUB_TOKEN, in that
# order of precedence. COPILOT_GITHUB_TOKEN is the most specific and is what this
# platform forwards to the runner. Env vars override any stored OAuth login.
#
# Create the token at https://github.com/settings/personal-access-tokens/new
#   - Resource owner: your PERSONAL account (not an organization — the required
#     permission only exists on user-owned tokens)
#   - Account permissions -> add "Copilot Requests"
#
# Supported token types:
#   github_pat_  fine-grained PAT       <- use this
#   gho_         OAuth (gh auth login / copilot /login)
#   ghu_         GitHub App user-to-server
#   ghp_         classic PAT            <- NOT supported
#
# A container has no stored interactive login, so this must be set for anything
# beyond EXECUTOR=local.
# COPILOT_GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# Optional: pin the model the agents use.
# Choices (CLI 0.0.365): claude-sonnet-4.5, claude-haiku-4.5, claude-opus-4.5,
# claude-sonnet-4, gpt-5, gpt-5.1, gpt-5.1-codex, gpt-5-mini, gpt-4.1,
# gemini-3-pro-preview
# COPILOT_MODEL=claude-sonnet-4.5

# --- persistence. SQLite by default; point at PostgreSQL for anything shared.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/aitest

# --- artifacts
# ARTIFACT_ROOT=./artifacts

# --- runner
RUNNER_IMAGE=ai-test-runner:dev
JOB_TIMEOUT_SECONDS=600
MAX_REVIEW_ATTEMPTS=2

# --- quality gate thresholds (read by the runner's validator)
GATE_MIN_TEST_CASES=5
GATE_MAX_DUPLICATE_RATE=0.10
GATE_MIN_STEPS=2
GATE_REQUIRED_CATEGORIES=3

# --- limits
MAX_CONCURRENT_JOBS_PER_USER=5
MAX_CONCURRENT_JOBS_TOTAL=20

# --- kubernetes (EXECUTOR=kubernetes)
K8S_NAMESPACE=ai-testing
K8S_SERVICE_ACCOUNT=ai-test-runner
K8S_SECRET_NAME=copilot-auth
K8S_ARTIFACT_PVC=ai-test-artifacts
K8S_TTL_SECONDS=3600
