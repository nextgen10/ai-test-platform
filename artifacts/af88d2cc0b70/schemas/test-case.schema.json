{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agenthub.local/schemas/test-case.schema.json",
  "title": "Generated Test Case Suite",
  "type": "object",
  "required": ["requirement_reference", "assumptions", "test_cases"],
  "additionalProperties": false,
  "properties": {
    "requirement_reference": {
      "type": "string",
      "description": "Identifier of the source requirement this suite was generated from.",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "description": "Explicitly recorded assumptions the generator made. Empty array if none.",
      "items": { "type": "string", "minLength": 1 }
    },
    "test_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "title",
          "category",
          "priority",
          "preconditions",
          "steps",
          "expected_result",
          "requirement_reference"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TC-[0-9]{3,}$",
            "description": "Unique test case identifier, e.g. TC-001."
          },
          "title": {
            "type": "string",
            "minLength": 5,
            "maxLength": 200
          },
          "category": {
            "type": "string",
            "enum": ["functional", "negative", "boundary", "validation", "data"]
          },
          "priority": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "preconditions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "steps": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 1 }
          },
          "expected_result": {
            "type": "string",
            "minLength": 5
          },
          "requirement_reference": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
